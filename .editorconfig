root = true

# 项目约定：Java/Gradle/JSON 使用 tab 缩进与 UTF-8；行尾统一 LF。
# 仓库历史由 Windows 检出，Git 侧通过 core.autocrlf 处理，提交内容保持 LF。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
