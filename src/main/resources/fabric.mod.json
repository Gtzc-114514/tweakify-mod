{
	"schemaVersion": 1,
	"id": "tweakify-mod",
	"version": "${version}",
	"name": "Tweakify Mod",
	"description": "把原版里零散、不可配置的行为整理成可开关、可绑定快捷键的选项。A collection of configurable vanilla tweaks.",
	"authors": [
		"Gtzc114514"
	],
	"contact": {
		"homepage": "https://github.com/Gtzc-114514/tweakify-mod",
		"sources": "https://github.com/Gtzc-114514/tweakify-mod",
		"issues": "https://github.com/Gtzc-114514/tweakify-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/tweakify-mod/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.gtzc.tweakify.TweakifyMod"
		],
		"client": [
			"com.gtzc.tweakify.client.TweakifyModClient"
		],
		"modmenu": [
			"com.gtzc.tweakify.client.TweakifyModMenu"
		]
	},
	"mixins": [
		{
			"config": "tweakify-mod.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "tweakify-mod.modmenu.mixins.json",
			"environment": "client"
		},
		{
			"config": "tweakify-mod.minihud.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.163.0+26.3",
		"malilib": ">=0.30.2- <0.31.0-"
	},
	"suggests": {
		"modmenu": "*",
		"minihud": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"GitHub Releases": "https://github.com/Gtzc-114514/tweakify-mod/releases",
				"Issue Tracker": "https://github.com/Gtzc-114514/tweakify-mod/issues"
			}
		}
	}
}