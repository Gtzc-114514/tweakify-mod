{
	"schemaVersion": 1,
	"id": "tweakify-mod",
	"version": "${version}",
	"name": "Tweakify Mod",
	"description": "这是一个调整优化原版机制的工具",
	"authors": [
		"Gtzc114514"
	],
	"contact": {
		"homepage": "https://github.com/Gtzc-114514/tweakify-mod",
		"sources": "https://github.com/Gtzc-114514/tweakify-mod",
		"issues": "https://github.com/Gtzc-114514/tweakify-mod/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/tweakify-mod/icon.png",
